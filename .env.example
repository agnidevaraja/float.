# float. - Environment Variables Template
# Copy this file to .env or .env.local for local overrides. NEVER commit .env or secrets to Git.

# Optional: Default Google Colab / Remote FastAPI + Qwen-2.5-7B GPU inference bridge URL.
# Points to our optional live Colab FastAPI + Qwen-2.5-7B GPU server, while float.
# automatically runs its built-in calibrated browser engine when offline or unreachable.
VITE_API_BASE_URL=https://merry-haven-picks-fire.trycloudflare.com

